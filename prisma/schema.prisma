// FINEX Forex Trading Platform - Prisma Schema
// SQLite untuk persistensi lokal di Windows 11 + VS Code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Konfigurasi global aplikasi (singleton)
model AppSettings {
  id              String   @id @default("singleton")
  // Tema & UI
  theme           String   @default("dark") // dark | light
  density         String   @default("compact") // compact | dense | minimal
  // Broker
  brokerName      String   @default("FINEX Indonesia")
  // MT5
  mt5Path         String   @default("C:\\Program Files\\FINEX Indonesia\\MetaTrader 5\\terminal64.exe")
  mt5Login       String   @default("")
  mt5Password    String   @default("")
  mt5Server       String   @default("FINEX-Live")
  mt5AutoLaunch   Boolean  @default(true)
  // Jadwal trading (24h format HH:MM)
  tradingStart    String   @default("08:00") // Sesi Asia
  tradingEnd      String   @default("23:30") // tutup sebelum sesi US akhir
  blockWeekend    Boolean  @default(true) // Sabtu & Minggu tidak trade
  // API Keys
  tiingoApiKey    String   @default("")
  groqApiKey      String   @default("")
  groqModel       String   @default("llama-3.3-70b-versatile")
  localAiEndpoint String  @default("http://127.0.0.1:11434/api/generate") // Ollama default
  localAiModel    String   @default("llama3.1:8b")
  // Default AI provider
  aiProvider      String   @default("groq") // groq | local
  // Risk default
  riskPerTradePct  Float   @default(0.5) // scalper 0.25-0.5%
  dailyStopPct     Float   @default(3.0)
  weeklyStopPct    Float   @default(5.0)
  maxLeverageRatio Float   @default(5.0)
  maxMarginUsagePct Float  @default(30.0)
  rrMin            Float   @default(1.5)
  // Timestamp
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Akun MT5 yang terhubung
model Mt5Account {
  id          String   @id @default(cuid())
  login       String
  server      String
  broker      String   @default("FINEX Indonesia")
  currency    String   @default("USD")
  leverage    Int      @default(500)
  equity      Float   @default(0)
  balance     Float   @default(0)
  margin      Float   @default(0)
  freeMargin  Float   @default(0)
  marginLevel Float   @default(0)
  connectedAt DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trades      Trade[]
}

// Trade / posisi (history & open)
model Trade {
  id           String   @id @default(cuid())
  ticket       Int      @unique // MT5 ticket
  accountId    String
  account      Mt5Account @relation(fields: [accountId], references: [id])
  symbol       String   // XAU/USD, EUR/USD, dst
  side         String   // BUY | SELL
  orderType    String   // MARKET | BUY_STOP | SELL_STOP | BUY_LIMIT | SELL_LIMIT
  lots         Float
  openPrice    Float
  closePrice   Float?
  stopLoss     Float?
  takeProfit   Float?
  slPips       Float?
  tpPips       Float?
  // Risk snapshot
  riskPct      Float?
  riskAmount   Float?
  rrPlanned    Float?
  // P&L
  profit       Float   @default(0)
  swap         Float   @default(0)
  commission   Float   @default(0)
  points       Float   @default(0)
  // Status & strategi
  status       String   @default("open") // open | closed | cancelled | pending
  strategyId   String?
  strategyName String?
  newsEventId  String?
  // Eksekusi
  isAuto       Boolean  @default(false)
  isManual     Boolean  @default(true)
  // Waktu
  openTime     DateTime
  closeTime    DateTime?
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
  @@index([symbol])
  @@index([status])
  @@index([openTime])
}

// Strategi trading
model Strategy {
  id           String   @id @default(cuid())
  name         String
  description  String
  type         String   // fade_spike | 15min_breakout | custom
  symbols      String   // CSV: XAU/USD,EUR/USD,...
  enabled      Boolean  @default(true)
  isAuto       Boolean  @default(false)
  // Parameter
  waitMinutes       Int   @default(15) // tunggu setelah rilis
  entryAfterBreakout Boolean @default(true)
  slPipsMax         Float  @default(40)
  tpPipsTarget      Float  @default(20)
  // Trigger news
  newsFilterImpact String  @default("high") // high | medium | low
  newsFilterCountry String @default("USD") // USD, EUR, GBP, JPY
  // Schedule (idle jadwal)
  activeStart    String @default("08:00")
  activeEnd      String @default("23:30")
  // Statistik
  totalTrades    Int     @default(0)
  wins           Int     @default(0)
  losses         Int     @default(0)
  totalProfit    Float   @default(0)
  winRate        Float   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Event berita ekonomi (dari Tiingo / Forex Factory)
model NewsEvent {
  id           String   @id @default(cuid())
  externalId   String?
  title        String
  country      String   // USD, EUR, GBP, JPY, etc
  currency     String   // USD, EUR, GBP, JPY
  impact       String   // high | medium | low
  eventTime    DateTime
  // Tiga Angka Emas
  previous     Float?
  forecast     Float?
  actual       Float?
  deviation    Float? // (actual - forecast) / forecast %
  // Hasil analisis
  directionUsd String?  // up | down | neutral
  directionXau String?  // up | down | neutral
  directionEur String?
  directionGbp String?
  directionJpy String?
  // Status
  isReleased   Boolean  @default(false)
  // Sumber
  source       String   @default("tiingo") // tiingo | manual | forex_factory
  // AI analisis
  aiSummary    String?
  aiConfidence Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventTime])
  @@index([country])
  @@index([impact])
}

// Sesi trading (jendela waktu aktif)
model TradingSession {
  id         String   @id @default(cuid())
  name       String   // Asia, London, NewYork, Custom
  startTime  String   // HH:MM
  endTime    String   // HH:MM
  daysOfWeek String   // CSV: 1,2,3,4,5 (Mon-Fri)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Pesan chat AI
model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // user | assistant | system
  provider  String   // groq | local
  model     String?
  content   String
  context   String?  // news id / strategy id / pair
  tokens    Int?
  latencyMs Int?
  createdAt DateTime @default(now())
}

// Tick harga (rolling buffer, di-truncate secara berkala)
model PriceTick {
  id        String   @id @default(cuid())
  symbol    String
  bid       Float
  ask       Float
  spread    Float
  time      DateTime
  createdAt DateTime @default(now())

  @@index([symbol, time])
}

// Log audit & runtime
model LogEntry {
  id        String   @id @default(cuid())
  level     String   // info | warn | error | debug
  source    String   // mt5 | strategy | ai | scheduler | trading
  message   String
  details   String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

// ============================================================
// FITUR BARU (20 fitur prioritas)
// ============================================================

// Pending order (Buy/Sell Stop/Limit) — Strategi B 15-Min Breakout
model PendingOrder {
  id          String   @id @default(cuid())
  ticket      Int      @unique // MT5 ticket
  accountId   String
  symbol      String
  orderType   String   // BUY_STOP | SELL_STOP | BUY_LIMIT | SELL_LIMIT
  lots        Float
  triggerPrice Float
  sl          Float?
  tp          Float?
  slPips      Float?
  tpPips      Float?
  status      String   @default("pending") // pending | filled | cancelled | expired
  strategyId  String?
  strategyName String?
  isAuto      Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([symbol])
  @@index([status])
}

// Alert rules (price, news, spread, SL/TP hit)
model AlertRule {
  id          String   @id @default(cuid())
  type        String   // price_above | price_below | news_pre | spread_wide | sl_tp_hit | margin_low | daily_stop
  symbol      String?
  condition   String   // JSON-encoded condition params
  message     String
  severity    String   @default("info") // info | warn | critical
  enabled     Boolean  @default(true)
  triggerCount Int     @default(0)
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([enabled])
}

// Backtest run
model BacktestRun {
  id           String   @id @default(cuid())
  strategyId   String
  strategyName String
  symbol       String
  timeframe    String   @default("M15")
  startDate    DateTime
  endDate      DateTime
  // Results
  initialBalance Float
  finalBalance   Float
  totalTrades    Int
  wins           Int
  losses         Int
  winRate        Float
  profitFactor   Float
  maxDrawdown    Float
  sharpeRatio    Float
  expectancy     Float
  avgRR          Float
  maxConsecutiveLosses Int
  // Config snapshot
  configJson    String
  tradesJson    String   // detail semua trade
  createdAt     DateTime @default(now())

  @@index([strategyId])
  @@index([createdAt])
}

// Trade journal entry (manual notes per trade)
model JournalEntry {
  id          String   @id @default(cuid())
  tradeTicket Int?     // link to Trade ticket
  symbol      String
  side        String
  entryTime   DateTime
  exitTime    DateTime?
  entryPrice  Float
  exitPrice   Float?
  lots        Float
  pnl         Float
  rrRealized  Float?
  strategy    String?
  setupQuality String?  // A | B | C (rating manual)
  emotion     String?   // calm | anxious | greedy | fearful
  mistakes    String?
  lessons     String?
  screenshotPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tradeTicket])
  @@index([symbol])
  @@index([entryTime])
}

// Hot key mapping
model Hotkey {
  id        String  @id @default(cuid())
  key       String  @unique  // F1, F2, etc
  action    String  // buy_market | sell_market | close_all | reverse_position | flatten | open_settings
  label     String
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Drawing object (trendline, fib, S/R, etc) — saved per symbol
model DrawingObject {
  id        String   @id @default(cuid())
  symbol    String
  type      String   // trendline | horizontal | fibonacci | rectangle | text
  pointsJson String  // JSON array of {x, y, time, price}
  styleJson String   // color, lineWidth, etc
  label     String?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
}

// Multi-account (untuk switch demo/live FINEX)
model Mt5AccountConfig {
  id        String   @id @default(cuid())
  label     String   // "Demo FINEX", "Live FINEX #1"
  login     String
  server    String
  broker    String   @default("FINEX Indonesia")
  accountType String @default("live") // live | demo | contest
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([login])
  @@index([isActive])
}

// API key vault (encrypted at rest via OS-level; here we only store metadata)
model ApiKeyVault {
  id        String   @id @default(cuid())
  provider  String   @unique // groq | tiingo | ollama | finex_api
  keyName   String
  keyMasked String   // hanya tampilan: gsk_***xxxx
  storedIn  String   @default("localstorage") // localstorage | keychain | env
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// P&L report (auto-generated periodic)
model PnlReport {
  id        String   @id @default(cuid())
  period    String   // daily | weekly | monthly | yearly
  startDate DateTime
  endDate   DateTime
  startingBalance Float
  endingBalance   Float
  totalPnl        Float
  totalTrades     Int
  winRate         Float
  profitFactor    Float
  maxDrawdown     Float
  bestTrade       Float
  worstTrade      Float
  pairsSummaryJson String  // P&L per pair
  strategiesSummaryJson String  // P&L per strategy
  pdfPath         String?
  createdAt       DateTime @default(now())

  @@index([period])
  @@index([startDate])
}

// Auto-disable trading config (pre-news flatten)
model AutoTradeRule {
  id          String   @id @default(cuid())
  name        String
  enabled     Boolean  @default(true)
  type        String   // pre_news_flatten | max_daily_loss | max_weekly_loss | trailing_stop_template
  minutesBefore Int?   // menit sebelum rilis (untuk pre_news_flatten)
  impactFilter String? // high | medium
  countryFilter String? // USD | EUR | all
  flattenAction String? @default("close_all") // close_all | reduce_50 | hedge
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Trade cloning (copy trading) — sumber & target
model CopyTradeSubscription {
  id           String   @id @default(cuid())
  sourceLogin  String   // master account
  targetLogin  String   // subscriber account
  scaleLots    Float    @default(1.0) // multiplier lot
  reverseMode  Boolean  @default(false)
  enabled      Boolean  @default(true)
  totalCopied  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceLogin])
  @@index([targetLogin])
}
