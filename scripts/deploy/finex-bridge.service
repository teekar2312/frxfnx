[Unit]
Description=FINEX MT5 Bridge Service (Socket.IO)
After=network.target

[Service]
Type=simple
User=finex
WorkingDirectory=/opt/finex-forex/mini-services/mt5-bridge
EnvironmentFile=/opt/finex-forex/.env.production
ExecStart=/usr/bin/node --experimental-strip-types index.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finex-bridge

# Resource limits
MemoryMax=500M
CPUQuota=100%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finex-forex/logs
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
