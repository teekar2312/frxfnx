# ============================================================
# FINEX Forex Trading Platform — Environment Configuration
# ============================================================
# Salin file ini ke .env.local (development) atau .env.production (production)
# dan isi nilai sesuai environment Anda.
#
# JANGAN COMMIT file .env.local atau .env.production yang berisi secrets asli!
# ============================================================

# --- App ---
NODE_ENV=production                    # development | production | test
APP_NAME=FINEX Forex Trading Platform
APP_VERSION=2.0.0
NEXT_PUBLIC_APP_URL=https://your-domain.com  # URL publik aplikasi
PORT=3000

# --- Database (SQLite untuk dev, PostgreSQL/MySQL untuk prod) ---
# Untuk SQLite: file:./db/custom.db
# Untuk PostgreSQL: postgresql://user:pass@localhost:5432/finex?schema=public
DATABASE_URL=file:./db/custom.db

# --- MT5 / FINEX Indonesia ---
MT5_PATH=C:\Program Files\FINEX Indonesia\MetaTrader 5\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=FINEX-Live
MT5_AUTO_LAUNCH=true
MT5_RECONNECT_INTERVAL=5000            # ms antar attempt reconnect
MT5_MAX_RECONNECT_ATTEMPTS=10

# --- Trading Schedule ---
TRADING_START=08:00
TRADING_END=23:30
BLOCK_WEEKEND=true
TRADING_SESSION=all                     # all | sydney | tokyo | london | newyork | overlap_sydney_tokyo | overlap_london_ny

# --- Risk Management ---
RISK_PER_TRADE_PCT=0.5
DAILY_STOP_PCT=3.0
WEEKLY_STOP_PCT=5.0
MAX_LEVERAGE_RATIO=5.0
MAX_MARGIN_USAGE_PCT=30.0
RR_MIN=1.5

# --- AI Providers ---
AI_PROVIDER=groq                        # groq | local

# Groq (cloud)
GROQ_API_KEY=                           # gsk_... (DAFTAR di https://console.groq.com/keys)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30000                       # ms

# Local AI (Ollama/LM Studio/vLLM/llama.cpp)
LOCAL_AI_TYPE=ollama                     # ollama | lmstudio | vllm | llamacpp | custom
LOCAL_AI_ENDPOINT=http://127.0.0.1:11434/api/generate
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT=60000

# --- Tiingo News API ---
TIINGO_API_KEY=                          # DAFTAR di https://api.tiingo.com/
TIINGO_TIMEOUT=15000

# --- Security ---
# Generate dengan: openssl rand -hex 32
NEXTAUTH_SECRET=                        # wajib untuk produksi (32+ chars random)
NEXTAUTH_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_MAX=100                      # max requests per window
RATE_LIMIT_WINDOW=60000                 # window dalam ms (60 detik)
API_KEY_ENCRYPTION_KEY=                 # 32-byte hex key untuk encrypt API keys at rest

# --- Logging ---
LOG_LEVEL=info                          # debug | info | warn | error | fatal
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_FILES=7
LOG_REDACT_FIELDS=password,apiKey,secret,token,authorization

# --- Bridge Service ---
BRIDGE_PORT=3004
BRIDGE_HOST=0.0.0.0
BRIDGE_CORS_ORIGIN=*

# --- Monitoring (opsional) ---
SENTRY_DSN=                             # https://sentry.io/ for error tracking
DATADOG_API_KEY=                         # https://datadoghq.com/
TELEMETRY_ENABLED=false
