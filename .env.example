# ============================================================
# FINEX Forex Trading Platform — Environment Configuration
# ============================================================
# Salin file ini ke .env (development) atau .env.production (production)
#   - Development: cp .env.example .env
#   - Production:  cp .env.production.example .env.production
#
# Edit nilai sesuai environment Anda.
# JANGAN COMMIT file .env atau .env.production yang berisi secrets asli!
# ============================================================

# --- App ---
NODE_ENV=development                      # development | production | test
APP_NAME=FINEX Forex Trading Platform
APP_VERSION=2.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# --- Database ---
# Untuk SQLite: file:./db/custom.db
# Untuk PostgreSQL: postgresql://user:pass@localhost:5432/finex?schema=public
DATABASE_URL=file:./db/custom.db

# --- MT5 / FINEX Indonesia ---
# Path ke terminal MT5 (Windows 11)
MT5_PATH=C:\Program Files\FINEX Indonesia\MetaTrader 5\terminal64.exe
MT5_LOGIN=                              # nomor akun MT5 (integer)
MT5_PASSWORD=                           # password MT5
MT5_SERVER=FINEX-Live                    # FINEX-Live atau FINEX-Demo
MT5_AUTO_LAUNCH=true                    # auto-launch MT5 jika belum running

# --- Trading Schedule ---
TRADING_START=08:00
TRADING_END=23:30
BLOCK_WEEKEND=true                       # blokir trading Sabtu & Minggu
# Pilih sesi: all | sydney | tokyo | london | newyork | overlap_sydney_tokyo | overlap_london_ny
TRADING_SESSION=all

# --- Risk Management ---
RISK_PER_TRADE_PCT=0.5                   # 0.5% per trade (scalper)
DAILY_STOP_PCT=3.0                       # daily stop 3%
WEEKLY_STOP_PCT=5.0                      # weekly stop 5%
MAX_LEVERAGE_RATIO=5.0                   # max leverage 5:1
MAX_MARGIN_USAGE_PCT=30.0                # max margin usage 30%
RR_MIN=1.5                               # min reward:risk ratio 1:1.5

# --- AI Providers ---
AI_PROVIDER=groq                         # groq | local

# Groq (cloud) — daftar di https://console.groq.com/keys
GROQ_API_KEY=                            # gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30000                       # ms

# Local AI (Ollama/LM Studio/vLLM/llama.cpp)
LOCAL_AI_TYPE=ollama                     # ollama | lmstudio | vllm | llamacpp | custom
LOCAL_AI_ENDPOINT=http://127.0.0.1:11434/api/generate
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT=60000                   # ms

# --- Tiingo News API ---
# Daftar di https://api.tiingo.com/
TIINGO_API_KEY=
TIINGO_TIMEOUT=15000

# --- Security ---
# Generate dengan: openssl rand -hex 32
NEXTAUTH_SECRET=                         # wajib untuk production (min 16 chars)
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:81
RATE_LIMIT_MAX=100                      # max requests per window
RATE_LIMIT_WINDOW=60000                 # window dalam ms (60 detik)
API_KEY_ENCRYPTION_KEY=                 # 32-byte hex key (optional, untuk encrypt API keys at rest)

# --- Logging ---
LOG_LEVEL=info                           # debug | info | warn | error | fatal
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_FILES=7
LOG_REDACT_FIELDS=password,apiKey,secret,token,authorization

# --- Bridge Service (Socket.IO) ---
BRIDGE_PORT=3004
BRIDGE_HOST=0.0.0.0
BRIDGE_CORS_ORIGIN=*

# --- Monitoring (opsional) ---
SENTRY_DSN=                             # https://sentry.io/ for error tracking
TELEMETRY_ENABLED=false
